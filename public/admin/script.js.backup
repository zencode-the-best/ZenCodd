const pluginsContainer = document.getElementById("plugins-list");

async function loadStats() {

    try {

        const res = await fetch("/api/admin/stats");
        const data = await res.json();

        if (!data.success) return;

        document.getElementById("plugins-count").textContent =
            data.stats.plugins;

        document.getElementById("downloads-count").textContent =
            data.stats.downloads;

    } catch (err) {

        console.error(err);

    }

}

async function loadPlugins() {

    try {

        const res = await fetch("/api/plugins");
        const plugins = await res.json();

        renderPlugins(plugins);

    } catch (err) {

        console.error(err);

    }

}

function renderPlugins(plugins) {

    pluginsContainer.innerHTML = "";

    if (!plugins.length) {

        pluginsContainer.innerHTML = `
            <p>Brak pluginów.</p>
        `;

        return;

    }

    plugins.forEach(plugin => {

        const div = document.createElement("div");

        div.className = "plugin-admin-card";

        div.innerHTML = `
            <h3>${plugin.name}</h3>

            <p>${plugin.description || "Brak opisu."}</p>

            <small>Wersja: ${plugin.version}</small><br>
            <small>Pobrań: ${plugin.downloads || 0}</small>

            <div class="admin-buttons">

                <button onclick="deletePlugin('${plugin.id}')">
                    🗑 Usuń
                </button>

            </div>
        `;

        pluginsContainer.appendChild(div);

    });

}

async function deletePlugin(id) {

    if (!confirm("Usunąć plugin?"))
        return;

    const res = await fetch(
        `/api/admin/plugin/${id}`,
        {
            method: "DELETE"
        }
    );

    const data = await res.json();

    if (!data.success) {

        alert(data.message || "Błąd.");

        return;

    }

    await loadStats();
    await loadPlugins();

}

loadStats();
loadPlugins();
